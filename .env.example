# Alpaca API - get from https://alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
# Set to "true" for live trading, "false" for paper trading
ALPACA_LIVE=false

# Twilio - get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+1XXXXXXXXXX

# Optional: a secret token TradingView will include in its webhook payload
# Set this to any random string and add it to your TradingView alert message as {"secret": "..."}
WEBHOOK_SECRET=your_secret_here
